# Parámetros locales sin secretos. `make env-init` lo copia a .env (ignorado por Git).
# Los secretos viven en keys/; aquí solo se nombra el archivo que los contiene.
# Sin comentarios al final de línea: el Makefile incluye este archivo.

# Caché de modelos de Hugging Face dentro del proyecto (ignorada por Git)
HF_HOME=models

# PostgreSQL de desarrollo (docker-compose.yml). El Makefile arma LICIGT_DB_URL.
LICIGT_DB_HOST=127.0.0.1
LICIGT_DB_PORT=5432
LICIGT_DB_NAME=licigt
LICIGT_DB_USER=licigt
LICIGT_DB_PASSWORD_FILE=keys/database/dev.password

# JEV de TypeSafe (rol 3): el código lee la clave desde este archivo
LICIGT_JEV_API_KEY_FILE=keys/jev/api.key
# Variante del enrutador: reglas, jev o llm
LICIGT_ENRUTADOR=reglas
# Versión fijada de JEV para las consultas y el sondeo
LICIGT_JEV_MODELO=jev-1.14.0

# LLM generador (rol 3): local por defecto u openai (llave en keys/llm/openai.key)
LICIGT_LLM=local
LICIGT_LLM_PUERTO=8080
LICIGT_LLM_CTX=12288
LICIGT_LLM_API_KEY_FILE=keys/llm/openai.key

# Recuperación (rol 2): dispositivo de bge-m3 y del reranker (auto, cuda o cpu) y precisión (float16 o float32)
# Con auto, float16 en CUDA y float32 en CPU; si CUDA no tiene memoria se cae a CPU
LICIGT_RECUPERACION_DISPOSITIVO=auto
LICIGT_RECUPERACION_DTYPE=

# Puerto de la API de la demo; Vite (make web) sirve en 5173 y le hace proxy de /api
LICIGT_API_PUERTO=8000
